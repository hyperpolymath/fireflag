# RSR-compliant .gitignore

# OS & Editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Build
/target/
/_build/
/build/
/dist/
/out/

# Dependencies
/node_modules/
/vendor/
/deps/
/.elixir_ls/

# Rust
# Cargo.lock  # Keep for binaries

# Elixir
/cover/
/doc/
*.ez
erl_crash.dump

# Julia
*.jl.cov
*.jl.mem
/Manifest.toml

# ReScript
/lib/bs/
/.bsb.lock

# Python (SaltStack only)
__pycache__/
*.py[cod]
.venv/

# Ada/SPARK
*.ali
/obj/
/bin/

# Haskell
/.stack-work/
/dist-newstyle/

# Chapel
*.chpl.tmp.*

# Secrets
.env
.env.*
*.pem
*.key
secrets/

# Test/Coverage
/coverage/
htmlcov/

# Logs
*.log
/logs/

# Temp
/tmp/
*.tmp
*.bak

# Crash recovery artifacts
ai-cli-crash-capture/

# ReScript/OCaml compiler artifacts
*.cmt
*.cmti
*.cmi
*.cmj
*.ast
# The rescript build mirrors each compiled source into `lib/ocaml/<Module>.res`
# as a stable backup copy.  The canonical sources live in `extension/lib/rescript/`
# and `tests/` (see rescript.json).  Ignore the mirror to keep git history clean.
/lib/ocaml/*.res
# Preserve the handful of files that ARE intentionally tracked there today
# (historic BucklScript layout).  `git add -f` can be used for new ones.
!/lib/ocaml/BrowserAPI.res
!/lib/ocaml/DatabaseUpdater.res
!/lib/ocaml/DevTools.res
!/lib/ocaml/Types.res
target/
node_modules/
_build/
deps/
.elixir_ls/
.cache/
build/
dist/
